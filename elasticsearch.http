@baseUrl = https://host.docker.internal:9200
@username = local-admin 
// #elastic
@password = Demo123!

### Get Elasticsearch node information
# @no-reject-unauthorized
GET {{baseUrl}}/
Authorization: Basic {{username}} {{password}}
# Save a known-good node response as ./expected/elasticsearch-node.json to enable this snapshot assertion.
 ?? body matchesJsonFile ./elasticsearch-node.json
 # The expected file contains the exact tagline text, without surrounding quotes.
 ?? body tagline matchesFile ./elasticsearch-cluster-tagline.txt --trim

### Check cluster health
# @no-reject-unauthorized
GET {{baseUrl}}/_cluster/health?pretty
Authorization: Basic {{username}} {{password}}
# Save a known-good health response as ./elasticsearch-cluster-health.json to enable this snapshot assertion.
 ?? body matchesJsonFile ./elasticsearch-cluster-health.json


### Create an API key for OTel logs and metrics
# @no-reject-unauthorized
POST {{baseUrl}}/_security/api_key
Authorization: Basic {{username}} {{password}}
Content-Type: application/json

{
  "name": "otel-ingest",
  "role_descriptors": {
    "otel_ingest": {
      "cluster": [],
      "indices": [
        {
          "names": ["logs-*", "metrics-*"],
          "privileges": ["create_doc", "auto_configure"]
        }
      ]
    }
  }
}
