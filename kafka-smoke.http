@messageId = {{$uuid}}

# @name publish
KAFKA host.docker.internal:9094
kafka_method: produce
kafka_topic: httpyac-local-smoke
kafka_partition: 0
kafka_key: {{messageId}}
kafka_sasl_mechanism: plain
kafka_username: admin
kafka_password: admin
content-type: application/json

{
  "messageId": "{{messageId}}",
  "text": "hello from httpyac"
}

